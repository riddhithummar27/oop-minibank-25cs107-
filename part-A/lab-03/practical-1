//then type: java Driver

class Point
{
    private int x;
    private int y;

    Point(int x, int y)
    {
        this.x = x;
        this.y = y;
    }

    public String toString()
    //if we remove public, it will give error as you are restricting as ovverride rule can't be more restrictive than the original method.
    {
        return "(" + x + ", " + y + ")";
    }

    //we will use equals method as we need to find distinct numbers
    public boolean equals(Object obj)
    {
        Point temp = (Point)obj;

        //we cant do this.x == obj.x as obj is of type Object and it doesn't have x and y. So we need to typecast it to Point.
        if(this.x == temp.x && this.y == temp.y)
        {
            return true;
        }

        else {
             return false;
        }
    }
}
import java.util.Scanner;


class Driver
{
    public static void main(String []args)
    {
        Point []p = new Point[5];
        Scanner sc = new Scanner(System.in);
        for(int i = 0; i < p.length; i++) 
        {
            System.out.println("Enter x and y coordinates for point " + (i + 1) + ":");
            int x = sc.nextInt();
            int y = sc.nextInt();
            p[i] = new Point(x, y);

            //can also write as p[i] = new Point(sc.nextInt(), sc.nextInt());   
        }

        int count = 0;

        for(int i = 0; i < p.length; i++)
        {
            for(int j = i + 1; j < p.length; j++)
            {
                if(p[i].equals(p[j]))
                {
                    System.out.println("Duplicate point found: " + p[i]);
                    count++;
                }
            }
            
        }
       System.out.println("Total number of distinct points: " + (p.length - count));
    }

    
}

