class Thermostat {

    private String location;
    private int temperature;

    private static final int MIN = 16;
    private static final int MAX = 30;
    private static int activeCount = 0;

    Thermostat(String location, int startTemp) {
        this.location = location;

        if (startTemp >= MIN && startTemp <= MAX) {
            temperature = startTemp;
        } else {
            temperature = 22;
        }

        activeCount++;
    }

    Thermostat(String location) {
        this(location, 22);
    }

    public void raise() {
        if (temperature < MAX) {
            temperature++;
        } else {
            System.out.println("Already at maximum (30)");
        }
    }

    public void lower() {
        if (temperature > MIN) {
            temperature--;
        } else {
            System.out.println("Already at minimum (16)");
        }
    }

    public int getTemperature() {
        return temperature;
    }

    public static int getActiveCount() {
        return activeCount;
    }
}

public class ThermostatDemo {

    public static void main(String[] args) {

        Thermostat t1 = new Thermostat("Living Room", 20);
        Thermostat t2 = new Thermostat("Bedroom", 25);

        System.out.println("Raising Temperature:");

        for (int i = 0; i < 10; i++) {
            t1.raise();
            System.out.println("t1 Temperature = " + t1.getTemperature());

            t2.raise();
            System.out.println("t2 Temperature = " + t2.getTemperature());
        }

        System.out.println("\nLowering Temperature:");

        for (int i = 0; i < 20; i++) {
            t1.lower();
            System.out.println("t1 Temperature = " + t1.getTemperature());

            t2.lower();
            System.out.println("t2 Temperature = " + t2.getTemperature());
        }

        System.out.println("\nActive Count = " + Thermostat.getActiveCount());
    }
}
