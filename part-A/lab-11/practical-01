// Practical 11 - Part A (1): Save and Load Serializable Objects

import java.io.*;

// Serializable class
class Student implements Serializable {

    private static final long serialVersionUID = 1L;

    int id;
    String name;
    transient String password;

    Student(int id, String name, String password) {
        this.id = id;
        this.name = name;
        this.password = password;
    }

    public String toString() {
        return "ID: " + id + ", Name: " + name
                + ", Password: " + password;
    }
}

public class SaveLoadDemo {

    public static void main(String[] args) {

        Student[] students = {
            new Student(1, "Radhi", "radhi123"),
            new Student(2, "Riya", "riya456"),
            new Student(3, "Priya", "priya789")
        };

        // Save objects to a file
        try (ObjectOutputStream out =
                     new ObjectOutputStream(
                             new FileOutputStream("students.dat"))) {

            out.writeObject(students);
            System.out.println("Objects saved successfully.");

        } catch (IOException e) {
            System.out.println("Error saving objects: " + e.getMessage());
        }

        // Load objects from the file
        try (ObjectInputStream in =
                     new ObjectInputStream(
                             new FileInputStream("students.dat"))) {

            Student[] loadedStudents = (Student[]) in.readObject();

            System.out.println("\nLoaded Student Details:");

            for (Student s : loadedStudents) {
                System.out.println(s);
            }

        } catch (IOException | ClassNotFoundException e) {
            System.out.println("Error loading objects: " + e.getMessage());
        }
    }
}
