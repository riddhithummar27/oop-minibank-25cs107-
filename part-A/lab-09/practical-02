
class SeatBooking {

    int seatsLeft = 5;

   
    public boolean bookWithoutSync() {

        if (seatsLeft > 0) {
           
            try {
                Thread.sleep(10);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }

            seatsLeft--;
            return true;
        }

        return false;
    }

    
    public synchronized boolean book() {

        if (seatsLeft > 0) {
            seatsLeft--;
            return true;
        }

        return false;
    }
}

public class SeatBookingRace {

    static final int THREADS = 10;

    public static void main(String[] args) throws InterruptedException {

       

        SeatBooking booking1 = new SeatBooking();

        Thread[] threads1 = new Thread[THREADS];

        int[] successfulBookings1 = {0};

        for (int i = 0; i < THREADS; i++) {

            threads1[i] = new Thread(() -> {

                if (booking1.bookWithoutSync()) {
                    synchronized (successfulBookings1) {
                        successfulBookings1[0]++;
                    }
                }

            });

            threads1[i].start();
        }

        for (Thread t : threads1) {
            t.join();
        }

        System.out.println("WITHOUT SYNCHRONIZATION");
        System.out.println("Successful bookings: "
                + successfulBookings1[0]);

        System.out.println("Seats left: "
                + booking1.seatsLeft);


       

        SeatBooking booking2 = new SeatBooking();

        Thread[] threads2 = new Thread[THREADS];

        int[] successfulBookings2 = {0};

        for (int i = 0; i < THREADS; i++) {

            threads2[i] = new Thread(() -> {

                if (booking2.book()) {
                    synchronized (successfulBookings2) {
                        successfulBookings2[0]++;
                    }
                }

            });

            threads2[i].start();
        }

        for (Thread t : threads2) {
            t.join();
        }

        System.out.println("\nWITH SYNCHRONIZATION");
        System.out.println("Successful bookings: "
                + successfulBookings2[0]);

        System.out.println("Seats left: "
                + booking2.seatsLeft);
    }
}
