abstract class Account {
    protected String accountNumber;
    protected String holderName;
    protected long balance;

    Account(String accountNumber, String holderName, long balance) {
        this.accountNumber = accountNumber;
        this.holderName = holderName;
        this.balance = balance;
    }

    abstract double interestRate();

    abstract boolean canWithdraw(long amount);
}

class SavingsAccount extends Account {
    private long minBalance;

    SavingsAccount(String accountNumber, String holderName, long balance, long minBalance) {
        super(accountNumber, holderName, balance);
        this.minBalance = minBalance;
    }

    @Override
    double interestRate() {
        return 4.0;
    }

    @Override
    boolean canWithdraw(long amount) {
        return balance - amount >= minBalance;
    }
}

class CurrentAccount extends Account {
    private long overdraftLimit;

    CurrentAccount(String accountNumber, String holderName, long balance, long overdraftLimit) {
        super(accountNumber, holderName, balance);
        this.overdraftLimit = overdraftLimit;
    }

    @Override
    double interestRate() {
        return 0.0;
    }

    @Override
    boolean canWithdraw(long amount) {
        return balance - amount >= -overdraftLimit;
    }
}

class FixedDepositAccount extends Account {

    FixedDepositAccount(String accountNumber, String holderName, long balance) {
        super(accountNumber, holderName, balance);
    }

    @Override
    double interestRate() {
        return 7.0;
    }

    @Override
    boolean canWithdraw(long amount) {
        return false;
    }
}

public class MiniBank {
    public static void main(String[] args) {

        Account[] accounts = {
            new SavingsAccount("SA101", "Riddhi", 50000, 10000),
            new CurrentAccount("CA102", "Anushka", 20000, 15000),
            new FixedDepositAccount("FD103", "Krisha", 100000)
        };

        for (Account account : accounts) {

            System.out.println("Account: " + account.accountNumber);
            System.out.println("Holder: " + account.holderName);
            System.out.println("Balance: ₹" + account.balance);
            System.out.println("Interest Rate: " + account.interestRate() + "%");

            if (account instanceof SavingsAccount savings) {
                System.out.println("Minimum Balance: ₹" + savings.minBalance);
            }

            System.out.println("Can Withdraw ₹15000: " + account.canWithdraw(15000));
            System.out.println("----------------------");
        }
    }
}
