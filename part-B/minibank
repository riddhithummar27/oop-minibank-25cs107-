import java.util.Scanner;

// Record
record BankInfo(String name, String branch) {}

// Enum
enum MenuOption {
    OPEN_ACCOUNT,
    DEPOSIT,
    WITHDRAW,
    TRANSFER,
    EXIT
}

public class MiniBank {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        BankInfo bank = new BankInfo("MiniBank", "Anand Branch");

        System.out.println("================================");
        System.out.println(bank);
        System.out.println("================================");

        // Create three accounts
        Account[] accounts = new Account[3];

        accounts[0] = new Account("Rahul", 1000);
        accounts[1] = new Account("Priya", 2000);
        accounts[2] = new Account("Amit");

        // Deposit and Withdraw
        accounts[0].deposit(500);

        if (accounts[1].withdraw(1000)) {
            System.out.println("Withdrawal successful.");
        } else {
            System.out.println("Insufficient balance.");
        }

        accounts[2].deposit(3000);

        // Print balances
        System.out.println("\nAccount Details");

        for (Account a : accounts) {
            System.out.println("Account No : " + a.getAccountNumber());
            System.out.println("Owner      : " + a.getOwnerName());
            System.out.println("Balance    : " + a.getBalance());
            System.out.println();
        }

        int choice;

        do {

            System.out.println("===== MiniBank Menu =====");
            System.out.println("1. Open Account");
            System.out.println("2. Deposit");
            System.out.println("3. Withdraw");
            System.out.println("4. Transfer");
            System.out.println("5. Exit");

            System.out.print("Enter your choice: ");
            choice = sc.nextInt();

            switch (choice) {

                case 1 ->
                    System.out.println(MenuOption.OPEN_ACCOUNT + " - To be implemented later.");

                case 2 ->
                    System.out.println(MenuOption.DEPOSIT + " - To be implemented later.");

                case 3 ->
                    System.out.println(MenuOption.WITHDRAW + " - To be implemented later.");

                case 4 ->
                    System.out.println(MenuOption.TRANSFER + " - To be implemented later.");

                case 5 ->
                    System.out.println("Thank you for using MiniBank.");

                default ->
                    System.out.println("Invalid choice.");

            }

            System.out.println();

        } while (choice != 5);

        sc.close();
    }
    public class Account {

    private final String accountNumber;
    private String ownerName;
    private long balance;
    private boolean active;

    private static int accountCounter = 1;

    private static String generateAccountNumber() {
        String number = String.format("AC%04d", accountCounter);
        accountCounter++;
        return number;
    }

    // Constructor with opening balance
    public Account(String ownerName, long balance) {
        this.accountNumber = generateAccountNumber();
        this.ownerName = ownerName;
        this.balance = balance;
        this.active = true;
    }

    // Constructor with only owner name
    public Account(String ownerName) {
        this(ownerName, 0);
    }

    // Deposit
    public void deposit(long amount) {
        balance = balance + amount;
    }

    // Withdraw
    public boolean withdraw(long amount) {
        if (balance >= amount) {
            balance = balance - amount;
            return true;
        } else {
            return false;
        }
    }

    public String getAccountNumber() {
        return accountNumber;
    }

    public String getOwnerName() {
        return ownerName;
    }

    public long getBalance() {
        return balance;
    }

    public boolean isActive() {
        return active;
    }
}

